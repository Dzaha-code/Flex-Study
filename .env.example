# Optional: account + sync between devices (Supabase).
# Leave empty and the app runs fully offline, with the sync panel explaining it
# is not enabled. Copy to .env.local and fill in from
# Supabase -> Project Settings -> API. The anon key is meant to be public;
# row-level security (supabase/migrations) keeps each user's rows private.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
