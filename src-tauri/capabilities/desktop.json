{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Desktop only: the floating task reminder window and in-app updates. The updater crate is not compiled for Android, so its permission must not reach a mobile build.",
  "platforms": [
    "windows",
    "macOS",
    "linux"
  ],
  "windows": [
    "main",
    "reminder"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-current-monitor",
    "core:window:allow-primary-monitor",
    "core:window:allow-destroy",
    "core:window:allow-show",
    "core:window:allow-unminimize",
    "core:window:allow-set-focus",
    "core:webview:allow-create-webview-window",
    "updater:default"
  ]
}
