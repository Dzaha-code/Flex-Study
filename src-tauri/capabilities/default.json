{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions every platform needs: the main window, notifications and the focus alarm.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "notification:default",
    "core:window:allow-request-user-attention",
    "core:window:allow-is-focused"
  ]
}
