# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# build / runtime caches (added)
/node-compile-cache/
/.buyer-execution-hooks/
*.log
.vercel
.env*

# desktop build artifacts
/out/
/src-tauri/target/

# Android build output. 3+ GB of Gradle intermediates and merged .so files.
# They were inside the CSS/Turbopack scan path, which is what made
# `npm run build` fail with "Insufficient system resources (os error 1450)".
/src-tauri/gen/android/.gradle/
/src-tauri/gen/android/build/
/src-tauri/gen/android/app/build/
/src-tauri/gen/android/local.properties
/src-tauri/gen/android/keystore.properties
/src-tauri/gen/android/**/*.apk
/src-tauri/gen/android/**/*.aab
*.jks
*.keystore
!.env.example

# Installers are published as GitHub Releases, not committed (72 MB and growing).
/installers/

# Local AI tooling leftovers; never part of the project.
/.freebuff/

# Extracted Android command-line tools kept next to the project.
/_cmdtools-extract/
/cmdline-tools.zip

# The template holds no secrets; it documents which variables exist.
!.env.example
# Local git bundle backups of rewritten history.
*.bundle
